<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Daybook — Smart Daily Planner</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F3F6F4;--card:#fff;--ink:#14231D;--mute:#6B7C74;--line:#E1E8E4;--acc:#1F7A5C;--accbg:#DDF1E8;--study:#3B6FE0;--work:#C7791A;--namaz:#1F7A5C;--exercise:#D0493C;--personal:#8A4FC4;--other:#6B7C74;--bad:#D0493C}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0E1512;--card:#17211C;--ink:#E8F1EC;--mute:#8FA39A;--line:#25332C;--acc:#4FC79B;--accbg:#1B3A2E;--study:#7BA2FF;--work:#F0AE55;--namaz:#4FC79B;--exercise:#FF8A7D;--personal:#C79BF2;--other:#8FA39A}}
:root[data-theme="dark"]{--bg:#0E1512;--card:#17211C;--ink:#E8F1EC;--mute:#8FA39A;--line:#25332C;--acc:#4FC79B;--accbg:#1B3A2E;--study:#7BA2FF;--work:#F0AE55;--namaz:#4FC79B;--exercise:#FF8A7D;--personal:#C79BF2;--other:#8FA39A}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.4 Figtree,system-ui,sans-serif;padding-bottom:90px}
h1,h2,.big{font-family:'Bricolage Grotesque',Figtree,sans-serif;margin:0}
#app{max-width:560px;margin:auto;padding:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:16px;margin-bottom:12px}
.mute{color:var(--mute);font-size:13px}.row{display:flex;align-items:center;gap:10px}.sp{justify-content:space-between}
.clock{font-size:52px;font-weight:700;letter-spacing:-2px;line-height:1}
.bar{height:8px;background:var(--line);border-radius:9px;overflow:hidden}.bar i{display:block;height:100%;background:var(--acc);border-radius:9px;transition:width .5s}
button,input,select,textarea{font:inherit;color:inherit}
.btn{background:var(--acc);color:var(--bg);border:0;border-radius:14px;padding:10px 16px;font-weight:600;cursor:pointer}
.btn.g{background:var(--accbg);color:var(--acc)}.btn.d{background:transparent;color:var(--bad);border:1px solid var(--line)}
input,select,textarea{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:10px;margin:4px 0 10px}
label{font-size:13px;color:var(--mute)}
.item{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}.item:last-child{border:0}
.dot{width:10px;align-self:stretch;border-radius:6px;min-height:34px;width:5px;flex:none}
.chk{width:24px;height:24px;border-radius:8px;border:2px solid var(--line);background:none;flex:none;cursor:pointer;color:var(--bg);font-size:14px}
.chk.on{background:var(--acc);border-color:var(--acc)}.done .t{text-decoration:line-through;color:var(--mute)}
.now{display:flex;align-items:center;gap:6px;color:var(--bad);font-size:12px;font-weight:600}.now:after{content:"";flex:1;height:2px;background:var(--bad)}
nav{position:fixed;bottom:0;left:0;right:0;background:var(--card);border-top:1px solid var(--line);display:flex;justify-content:center;padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px))}
nav div{display:flex;width:100%;max-width:560px}nav button{flex:1;background:none;border:0;padding:6px;color:var(--mute);font-size:11px;cursor:pointer;border-radius:14px}nav button.on{color:var(--acc);background:var(--accbg);font-weight:600}nav b{display:block;font-size:20px}
.chips{display:flex;gap:6px;overflow-x:auto;margin:8px 0}.chip{border:1px solid var(--line);background:var(--card);border-radius:20px;padding:5px 12px;white-space:nowrap;cursor:pointer}.chip.on{background:var(--acc);color:var(--bg);border-color:var(--acc)}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}.day{padding:8px 0;border-radius:12px;cursor:pointer;min-height:44px}.day.sel{background:var(--acc);color:var(--bg)}.day.today{outline:2px solid var(--acc)}.day small{display:block;font-size:9px;letter-spacing:2px}
.wk{display:flex;gap:6px;align-items:flex-end;height:80px}.wk div{flex:1;background:var(--accbg);border-radius:8px 8px 0 0;position:relative}.wk div i{position:absolute;bottom:0;left:0;right:0;background:var(--acc);border-radius:8px 8px 0 0}
#modal{position:fixed;inset:0;background:#0008;display:none;align-items:flex-end;justify-content:center;z-index:9}#modal.open{display:flex}
#sheet{background:var(--card);width:100%;max-width:560px;max-height:90%;overflow:auto;border-radius:24px 24px 0 0;padding:18px;animation:up .25s}@keyframes up{from{transform:translateY(40px);opacity:0}}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head><body>
<div id="app"></div><nav><div id="nav"></div></nav><div id="modal"><div id="sheet"></div></div>
<script>
const K='daybook_v1',$=q=>document.querySelector(q);
let S={};try{S=JSON.parse(localStorage.getItem(K))||{}}catch(e){}
S=Object.assign({name:'',h24:false,theme:'auto',defRem:10,wk:1,tasks:[],nz:{},nzDone:{},study:[]},S);
const save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};
const CATS={study:['📚','Study'],work:['💼','Work'],namaz:['🕌','Namaz'],exercise:['🏋️','Exercise'],personal:['🏠','Personal'],other:['🔔','Other']};
const NZ=['Fajr','Dhuhr','Asr','Maghrib','Isha'];
const p2=n=>String(n).padStart(2,'0'),ds=d=>d.getFullYear()+'-'+p2(d.getMonth()+1)+'-'+p2(d.getDate());
const addD=(d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);return x};
const ft=t=>{if(!t)return'';let[h,m]=t.split(':').map(Number);if(S.h24)return p2(h)+':'+p2(m);return(h%12||12)+':'+p2(m)+' '+(h<12?'AM':'PM')};
const nowT=()=>{const d=new Date();return p2(d.getHours())+':'+p2(d.getMinutes())};
const cv=v=>`var(--${v})`;
let tab='home',selDate=ds(new Date()),calM=new Date(),q='',flt='all',today=ds(new Date());
const occ=(t,d)=>{const D=new Date(d+'T00:00'),B=new Date(t.date+'T00:00'),r=t.rep;if(t.rep==='none'||!r)return t.date===d;if(D<B)return false;const w=D.getDay();
 if(r==='daily')return true;if(r==='weekly')return w===B.getDay();if(r==='weekdays')return w>0&&w<6;if(r==='monthly')return D.getDate()===B.getDate();
 if(r.startsWith('every')){const n=+r.slice(5)||1;return Math.round((D-B)/864e5)%n===0}return false};
const items=d=>{const a=S.tasks.filter(t=>occ(t,d)).map(t=>({id:t.id,title:t.title,start:t.start,end:t.end,cat:t.cat,pri:t.pri,desc:t.desc,done:!!(t.done||{})[d],task:t}));
 NZ.forEach(n=>{if(S.nz[n])a.push({id:'nz'+n,title:n,start:S.nz[n],cat:'namaz',nz:n,done:!!(S.nzDone[d]||{})[n]})});
 return a.sort((x,y)=>(x.start||'99').localeCompare(y.start||'99'))};
const prog=d=>{const a=items(d),c=a.filter(x=>x.done).length;return{a,c,n:a.length,pct:a.length?Math.round(c/a.length*100):0}};
const toggle=(id,d)=>{if(id.startsWith('nz')){const n=id.slice(2);(S.nzDone[d]=S.nzDone[d]||{})[n]=!S.nzDone[d][n]}else{const t=S.tasks.find(x=>x.id===id);t.done=t.done||{};t.done[d]=!t.done[d]}save();render()};
const streaks=()=>{let cur=0,best=0,run=0;for(let i=0;i<365;i++){const p=prog(ds(addD(new Date(),-i)));if(p.n&&p.c===p.n){run++;best=Math.max(best,run)}else{if(i>0&&cur===0&&run===0){}else if(cur===0)cur=run;if(!(i===0)){}run=0}if(i===0&&!(p.n&&p.c===p.n)){run=0}}
 let c=0,s=0;for(let i=ds(new Date())?0:0;i<365;i++){const p=prog(ds(addD(new Date(),-i)));const ok=p.n&&p.c===p.n;if(ok)c++;else if(i>0)break}return{cur:c,best}};
const studyMin=(from)=>S.study.filter(s=>s.date>=from).reduce((a,s)=>a+s.mins,0);
const hm=m=>Math.floor(m/60)+'h '+m%60+'m';
const row=(x,d)=>`<div class="item ${x.done?'done':''}"><span class="dot" style="background:${cv(x.cat)}"></span>
 <button class="chk ${x.done?'on':''}" onclick="toggle('${x.id}','${d}')" aria-label="Toggle done">${x.done?'✓':''}</button>
 <div style="flex:1;cursor:pointer" ${x.nz?'':`onclick="editTask('${x.id}')"`}><div class="t">${CATS[x.cat][0]} ${esc(x.title)}${x.pri==='high'?' <b style="color:var(--bad)">!</b>':''}</div>
 <div class="mute">${ft(x.start)}${x.end?' – '+ft(x.end):''}${!x.done&&x.start&&d<today?' · overdue':!x.done&&x.start&&d===today&&x.start<nowT()?' · overdue':''}</div></div></div>`;
const esc=s=>String(s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
// study timer
let T={mode:'focus',left:25*60,run:false,subj:'',dur:25,logged:0};
setInterval(()=>{if(T.run){T.left--;if(T.left<=0){T.run=false;if(T.mode==='focus'){S.study.push({date:ds(new Date()),subject:T.subj||'General',mins:T.dur});save();notify('Study session complete','Take a break!')}else notify('Break over','Back to work.');T.left=0;render();}}tick()},1000);
function tick(){const d=new Date(),n=ds(d);if(n!==today){today=n;selDate=n;render()}
 const c=$('#clk');if(c)c.textContent=S.h24?p2(d.getHours())+':'+p2(d.getMinutes())+':'+p2(d.getSeconds()):ft(nowT()).replace(/ .*/,'')+':'+p2(d.getSeconds());
 const a=$('#ampm');if(a)a.textContent=S.h24?'':d.getHours()<12?'AM':'PM';const tm=$('#tm');if(tm)tm.textContent=p2(Math.floor(T.left/60))+':'+p2(T.left%60);
 if(d.getSeconds()===0||!window._lastMin)remind(d)}
const fired=new Set();
function remind(d){window._lastMin=1;const n=ds(d),cur=d.getHours()*60+d.getMinutes();
 items(n).forEach(x=>{if(!x.start||x.done)return;const[h,m]=x.start.split(':').map(Number),rem=x.nz?10:(x.task.rem??S.defRem);const key=n+x.id+x.start;
  if(!fired.has(key)&&cur>=h*60+m-rem&&cur<=h*60+m){fired.add(key);notify(x.title,rem&&cur<h*60+m?'Starts in '+(h*60+m-cur)+' min':'Starting now')}})}
function notify(t,b){try{if(window.Notification&&Notification.permission==='granted')new Notification(t,{body:b})}catch(e){}}
function askNotif(){try{Notification.requestPermission().then(()=>render())}catch(e){alert('Notifications are not supported in this browser.')}}
// views
function home(){const d=new Date(),p=prog(today),nx=p.a.find(x=>!x.done&&x.start>=nowT()),nn=p.a.find(x=>x.nz&&!x.done&&x.start>=nowT());
 const nowIdx=p.a.findIndex(x=>x.start>nowT());let tl='';p.a.forEach((x,i)=>{if(i===nowIdx||(nowIdx<0&&i===p.a.length))tl+=`<div class="now">${ft(nowT())} now</div>`;tl+=row(x,today)});if(nowIdx<0&&p.a.length)tl+=`<div class="now">now</div>`;
 const notif=window.Notification&&Notification.permission==='default'?`<div class="card row sp"><span class="mute" style="flex:1">Allow notifications so reminders reach you before tasks and prayers start.</span><button class="btn g" onclick="askNotif()">Allow</button></div>`:'';
 return`<div class="row sp"><div><div class="mute">${d.toLocaleDateString(undefined,{weekday:'long'})}</div><h2>${d.toLocaleDateString(undefined,{day:'numeric',month:'long',year:'numeric'})}</h2></div><div class="mute">${S.name?'Hi, '+esc(S.name):''}</div></div>
 <div class="card" style="margin-top:12px"><div class="row" style="align-items:baseline"><span class="clock" id="clk"></span><span class="mute" id="ampm"></span></div>
 <div class="row sp" style="margin:14px 0 6px"><b>Today's progress</b><b>${p.pct}%</b></div><div class="bar"><i style="width:${p.pct}%"></i></div><div class="mute" style="margin-top:6px">${p.c} done · ${p.n-p.c} pending</div></div>
 ${notif}<div class="two"><div class="card"><div class="mute">What's next</div><b>${nx?esc(nx.title):'All clear'}</b><div class="mute">${nx?ft(nx.start):''}</div></div>
 <div class="card"><div class="mute">Next Namaz</div><b>${nn?nn.title:'—'}</b><div class="mute">${nn?ft(nn.start):Object.keys(S.nz).length?'Done for today':'Set times in Profile'}</div></div></div>
 <div class="card"><div class="row sp"><h2 style="font-size:20px">Today's timeline</h2><button class="btn" onclick="editTask()">+ Add task</button></div>${tl||'<p class="mute">Nothing scheduled. Add your first task.</p>'}</div>`}
function tasks(){let a=S.tasks.filter(t=>(flt==='all'||t.cat===flt)&&t.title.toLowerCase().includes(q.toLowerCase()));
 return`<h2>Tasks</h2><input placeholder="Search tasks" value="${esc(q)}" oninput="q=this.value;render(1)" id="srch"><div class="chips"><span class="chip ${flt==='all'?'on':''}" onclick="flt='all';render()">All</span>${Object.entries(CATS).map(([k,v])=>`<span class="chip ${flt===k?'on':''}" onclick="flt='${k}';render()">${v[0]} ${v[1]}</span>`).join('')}</div>
 <div class="card">${a.length?a.sort((x,y)=>x.date.localeCompare(y.date)).map(t=>row({id:t.id,title:t.title,start:t.start,end:t.end,cat:t.cat,pri:t.pri,done:!!(t.done||{})[t.date]},t.date)).join('').replace(/(<div class="mute">)/g,'$1')+'':'<p class="mute">No tasks yet.</p>'}</div><button class="btn" onclick="editTask()">+ New task</button>`}
function cal(){const y=calM.getFullYear(),m=calM.getMonth(),first=new Date(y,m,1),off=(first.getDay()-S.wk+7)%7,dim=new Date(y,m+1,0).getDate();
 const hd=[...Array(7)].map((_,i)=>'SMTWTFS'[(i+S.wk)%7]);let g=hd.map(h=>`<small>${h}</small>`).join('');for(let i=0;i<off;i++)g+='<div></div>';
 for(let i=1;i<=dim;i++){const d=y+'-'+p2(m+1)+'-'+p2(i),p=prog(d);g+=`<div class="day ${d===selDate?'sel':''} ${d===today?'today':''}" onclick="selDate='${d}';render()">${i}<small style="color:${p.n?(p.c===p.n?'var(--acc)':'var(--bad)'):'transparent'}">●</small></div>`}
 const p=prog(selDate);return`<div class="row sp"><button class="btn g" onclick="calM=new Date(${y},${m-1},1);render()">‹</button><h2>${calM.toLocaleDateString(undefined,{month:'long',year:'numeric'})}</h2><button class="btn g" onclick="calM=new Date(${y},${m+1},1);render()">›</button></div>
 <div class="card grid" style="margin-top:12px">${g}</div><div class="card"><div class="row sp"><b>${new Date(selDate+'T00:00').toLocaleDateString(undefined,{weekday:'long',day:'numeric',month:'short'})}</b><button class="btn" onclick="editTask(null,'${selDate}')">+ Add</button></div>${p.a.map(x=>row(x,selDate)).join('')||'<p class="mute">No tasks this day.</p>'}<div class="mute">Green = all done, red = pending</div></div>`}
function study(){const wkStart=ds(addD(new Date(),-6)),td=S.study.filter(s=>s.date===today);
 return`<h2>Study mode</h2><div class="card" style="text-align:center"><div class="mute">${T.mode==='focus'?'Focus':'Break'}</div><div class="clock" id="tm" style="color:var(--study);margin:8px 0"></div>
 ${T.run||T.left<T.dur*60&&T.mode==='focus'?'':`<label>Subject</label><input id="subj" value="${esc(T.subj)}" placeholder="e.g. DSA" onchange="T.subj=this.value"><label>Duration (min)</label><input id="dur" type="number" min="1" value="${T.dur}" onchange="T.dur=+this.value||25;T.left=T.dur*60">`}
 <div class="row" style="justify-content:center"><button class="btn" onclick="T.run=!T.run;render()">${T.run?'Pause':T.left<T.dur*60&&T.left>0?'Resume':'Start'}</button><button class="btn g" onclick="T.mode='break';T.run=true;T.left=300;render()">5 min break</button><button class="btn d" onclick="T={...T,mode:'focus',run:false,left:T.dur*60};render()">Reset</button></div></div>
 <div class="two"><div class="card"><div class="mute">Today</div><b class="big" style="font-size:24px">${hm(studyMin(today))}</b></div><div class="card"><div class="mute">Last 7 days</div><b class="big" style="font-size:24px">${hm(studyMin(wkStart))}</b></div></div>
 <div class="card"><b>Completed sessions today</b>${td.map(s=>`<div class="item"><span class="dot" style="background:var(--study)"></span>${esc(s.subject)}<span class="mute" style="margin-left:auto">${s.mins} min</span></div>`).join('')||'<p class="mute">None yet. Start a session.</p>'}</div>`}
function profile(){const st=streaks(),days=[...Array(7)].map((_,i)=>{const d=addD(new Date(),i-6);return{l:d.toLocaleDateString(undefined,{weekday:'narrow'}),p:prog(ds(d)).pct}});
 const nzc=[...Array(7)].reduce((a,_,i)=>a+Object.values(S.nzDone[ds(addD(new Date(),-i))]||{}).filter(Boolean).length,0);
 const tc=S.tasks.reduce((a,t)=>a+Object.values(t.done||{}).filter(Boolean).length,0);
 return`<h2>Profile</h2><div class="two" style="margin-top:12px"><div class="card"><div class="mute">Current streak</div><b class="big" style="font-size:28px">${st.cur} days</b></div><div class="card"><div class="mute">Best streak</div><b class="big" style="font-size:28px">${st.best} days</b></div>
 <div class="card"><div class="mute">Tasks completed</div><b class="big" style="font-size:28px">${tc}</b></div><div class="card"><div class="mute">Namaz this week</div><b class="big" style="font-size:28px">${nzc}/35</b></div></div>
 <div class="card"><b>Weekly completion</b><div class="wk" style="margin-top:10px">${days.map(d=>`<div style="height:100%"><i style="height:${d.p}%"></i></div>`).join('')}</div><div class="wk" style="height:auto;margin-top:4px">${days.map(d=>`<span class="mute" style="flex:1;text-align:center">${d.l}</span>`).join('')}</div></div>
 <div class="card"><b>Prayer times</b><p class="mute">Enter times for your location, taken from your local mosque or a prayer-time source. Nothing is pre-filled.</p><div class="two">${NZ.map(n=>`<div><label>${n}</label><input type="time" value="${S.nz[n]||''}" onchange="S.nz['${n}']=this.value||undefined;save()"></div>`).join('')}</div></div>
 <div class="card"><b>Settings</b><label>Name</label><input value="${esc(S.name)}" onchange="S.name=this.value;save()">
 <div class="two"><div><label>Time format</label><select onchange="S.h24=this.value==='24';save();render()"><option value="12">12-hour</option><option value="24" ${S.h24?'selected':''}>24-hour</option></select></div>
 <div><label>Theme</label><select onchange="S.theme=this.value;save();applyTheme()">${['auto','light','dark'].map(v=>`<option ${S.theme===v?'selected':''}>${v}</option>`)}</select></div>
 <div><label>Default reminder</label><select onchange="S.defRem=+this.value;save()">${[[0,'At exact time'],[5,'5 min before'],[10,'10 min before'],[15,'15 min before'],[30,'30 min before']].map(([v,l])=>`<option value="${v}" ${S.defRem===v?'selected':''}>${l}</option>`)}</select></div>
 <div><label>Week starts on</label><select onchange="S.wk=+this.value;save()"><option value="1">Monday</option><option value="0" ${S.wk===0?'selected':''}>Sunday</option></select></div></div>
 <div class="row" style="flex-wrap:wrap"><button class="btn g" onclick="askNotif()">Notifications: ${window.Notification?Notification.permission:'n/a'}</button><button class="btn g" onclick="exp()">Export data</button><button class="btn d" onclick="if(confirm('Delete all data?')){localStorage.removeItem(K);location.reload()}">Reset</button></div></div>`}
function exp(){const a=document.createElement('a');a.href='data:application/json,'+encodeURIComponent(JSON.stringify(S,null,1));a.download='daybook-backup.json';a.click()}
function editTask(id,date){const t=S.tasks.find(x=>x.id===id)||{title:'',desc:'',date:date||selDate||today,start:'',end:'',cat:'personal',pri:'medium',rep:'none',rem:S.defRem};
 $('#sheet').innerHTML=`<h2>${id?'Edit task':'New task'}</h2><label>Title</label><input id="f_t" value="${esc(t.title)}"><label>Description</label><textarea id="f_d" rows="2">${esc(t.desc)}</textarea>
 <div class="two"><div><label>Date</label><input type="date" id="f_dt" value="${t.date}"></div><div><label>Category</label><select id="f_c">${Object.entries(CATS).map(([k,v])=>`<option value="${k}" ${t.cat===k?'selected':''}>${v[0]} ${v[1]}</option>`)}</select></div>
 <div><label>Start</label><input type="time" id="f_s" value="${t.start}"></div><div><label>End</label><input type="time" id="f_e" value="${t.end}"></div>
 <div><label>Priority</label><select id="f_p">${['low','medium','high'].map(v=>`<option ${t.pri===v?'selected':''}>${v}</option>`)}</select></div>
 <div><label>Repeat</label><select id="f_r">${[['none','Never'],['daily','Daily'],['weekly','Weekly'],['weekdays','Mon–Fri'],['monthly','Monthly'],['every2','Every 2 days'],['every3','Every 3 days']].map(([v,l])=>`<option value="${v}" ${t.rep===v?'selected':''}>${l}</option>`)}</select></div></div>
 <label>Reminder</label><select id="f_m">${[[0,'At exact time'],[5,'5 min before'],[10,'10 min before'],[15,'15 min before'],[30,'30 min before']].map(([v,l])=>`<option value="${v}" ${t.rem===v?'selected':''}>${l}</option>`)}</select>
 <div class="row"><button class="btn" onclick="saveTask('${id||''}')">Save</button><button class="btn g" onclick="closeM()">Cancel</button>${id?`<button class="btn d" onclick="delTask('${id}')">Delete</button>`:''}</div>`;$('#modal').classList.add('open')}
const closeM=()=>$('#modal').classList.remove('open');
function saveTask(id){const title=$('#f_t').value.trim();if(!title){$('#f_t').focus();return}
 const o={title,desc:$('#f_d').value,date:$('#f_dt').value||today,cat:$('#f_c').value,start:$('#f_s').value,end:$('#f_e').value,pri:$('#f_p').value,rep:$('#f_r').value,rem:+$('#f_m').value};
 if(id)Object.assign(S.tasks.find(x=>x.id===id),o);else S.tasks.push({id:'t'+Date.now(),done:{},...o});save();closeM();render()}
function delTask(id){S.tasks=S.tasks.filter(x=>x.id!==id);save();closeM();render()}
$('#modal').onclick=e=>{if(e.target.id==='modal')closeM()};
function applyTheme(){document.documentElement.dataset.theme=S.theme==='auto'?'':S.theme}
const NAV=[['home','🏠','Home'],['tasks','✅','Tasks'],['cal','📅','Calendar'],['study','📚','Study'],['profile','👤','Profile']];
function render(keep){const V={home,tasks,cal,study,profile};$('#app').innerHTML=V[tab]();$('#nav').innerHTML=NAV.map(([k,i,l])=>`<button class="${tab===k?'on':''}" onclick="tab='${k}';render()"><b>${i}</b>${l}</button>`).join('');
 if(keep){const s=$('#srch');if(s){s.focus();s.setSelectionRange(99,99)}}tick()}
applyTheme();render();
</script></body></html>
